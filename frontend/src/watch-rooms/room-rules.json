  "fallback": {
    "stay": "__stay__",
    "firstAvailable": null,
    "watchFallbackNames": ["favorites", "nearby", "home"],
    "rule": "Stay on current page stores the sentinel; First available page stores no key, and the watch then takes a page whose normalized name is one of watchFallbackNames, else the first page. A page id is a page's id as stored. The pages offered are the listed pages that are neither system nor hidden pages."
  },
  "mappings": {
    "rule": "roomQuickJumpMappings maps a normalized room name to a page id. A room set to no page has no key, and an empty mapping is no key at all. The watch normalizes every key before it compares, and also takes a key that contains the room or is contained by it."
  },
