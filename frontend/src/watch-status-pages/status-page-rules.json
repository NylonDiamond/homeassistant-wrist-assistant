  "matchFilter": {
    "token": "the row's filterState, else defaultFilterState for its domain",
    "compare": "the state and the token both lowercased",
    "rule": "for a domain listed here: a token in anyActiveTokens matches every state not in inactiveStates (or every state in activeStates); a token in tokenMeansState matches that one state; any other token, and every other domain, matches the state equal to the token",
    "domains": {
      "climate": {
        "anyActiveTokens": ["on", "active"],
        "inactiveStates": ["off", "unavailable", "unknown", "none", ""]
      },
      "water_heater": {
        "anyActiveTokens": ["on", "active"],
        "inactiveStates": ["off", "unavailable", "unknown", "none", ""]
      },
      "media_player": {
        "anyActiveTokens": ["on", "active"],
        "inactiveStates": ["off", "idle", "standby", "unavailable", "unknown", "none", ""]
      },
      "vacuum": {
        "anyActiveTokens": ["on", "active", "cleaning"],
        "activeStates": ["cleaning", "returning", "paused", "on"]
      },
      "alarm_control_panel": {
        "anyActiveTokens": ["on", "active", "armed"],
        "inactiveStates": ["disarmed", "off", "unavailable", "unknown", "none", ""]
      },
      "valve": {
        "tokenMeansState": {
          "open": "open",
          "on": "open",
          "closed": "closed",
          "off": "closed"
        }
      }
    }
  },
  "coverValue": {
    "naStates": ["unavailable", "unknown", ""],
    "na": "N/A",
    "rule": "naStates: N/A; closed: Closed whatever the position; a position between 1 and 99: <position>%; else the state's word, or the state capitalized",
    "words": {
      "open": "Open",
      "closed": "Closed",
      "opening": "Opening",
      "closing": "Closing"
    }
  },
  "maxValueLabels": {
    "by": "the first class in deviceClassFilter",
    "labels": {
      "battery": "Max value (%)",
      "humidity": "Max value (%)",
      "moisture": "Max value (%)",
      "temperature": "Max value (°)",
      "power": "Max value (W)",
      "illuminance": "Max value (lx)",
      "pressure": "Max value (hPa)",
      "*": "Max value"
    }
  },
