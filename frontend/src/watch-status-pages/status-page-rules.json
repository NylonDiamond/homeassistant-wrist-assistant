  "fetchPlan": {
    "rule": "visible rows only: an entity row adds entityId when not empty; a group count adds groupEntityIds; a dynamic list adds groupEntityIds unless dynamicMode is all, when it adds its domain with deviceClassFilter; one domain asked twice gets the sorted union of its classes, and a whole-domain ask wins"
  },
  "fill": {
    "source": "StatusPageSnippetView.resolvedRows and groupCountValue (watch only; transcribed, not generated)",
    "hiddenRows": "a row with isHidden true is skipped, a hidden header too",
    "entity": "one row: displayName, iconName, the value of entityId's state (display)",
    "sectionHeader": "displayName uppercased, aligned by headerAlignment (absent is leading); no value",
    "groupCount": {
      "count": "the groupEntityIds whose state matches the row (matchFilter); an entity with no state does not count",
      "value": "<count> <filterState, else activeLabel for the domain>",
      "numeric": "domain sensor with maxNumericValue: count the states that parse as a number at or below it; value <count> <filterState, else low>"
    },
    "dynamicList": {
      "candidates": {
        "all": "every fetched entity whose id starts with <domain>., sorted by entity id",
        "specific": "groupEntityIds in their order"
      },
      "filters": [
        "deviceClassFilter not empty: keep entities whose device_class attribute is in it (no device_class: dropped)",
        "an entity with no state: dropped",
        "showAllStates not true: keep states that match the row (matchFilter)",
        "maxNumericValue set: keep states that parse as a number at or below it"
      ],
      "row": "each kept entity is an entity row: friendly_name, else the part of the id after the dot; the list's iconName and domain"
    },
    "twoColumn": "headers take the full width; other rows pair up in order; a row left alone before a header or at the end takes the left half",
    "numberParse": "Swift Double(String): decimal or exponent with an optional sign, a leading or trailing point, hexadecimal (0x1A), inf and nan; no spaces"
  },
  "display": {
    "source": "StatusPageSnippetView.formatValue (watch only; transcribed, not generated)",
    "noState": "N/A",
    "domains": {
      "lock": {
        "locked": "Locked",
        "*": "Unlocked"
      },
      "alarm_control_panel": {
        "disarmed": "Disarmed",
        "armed_home": "Armed Home",
        "armed_away": "Armed Away",
        "armed_night": "Armed Night",
        "armed_vacation": "Armed Vacation",
        "armed_custom_bypass": "Custom Bypass",
        "pending": "Pending",
        "arming": "Arming",
        "disarming": "Disarming",
        "triggered": "Triggered!",
        "*": "Disarmed"
      },
      "climate": {
        "attribute": "current_temperature",
        "value": "rounding.climate, then unit_of_measurement (else °) with no space",
        "noAttribute": "the state, capitalized"
      },
      "light": {
        "on": "On",
        "*": "Off"
      },
      "switch": {
        "on": "On",
        "*": "Off"
      },
      "input_boolean": {
        "on": "On",
        "*": "Off"
      },
      "fan": {
        "on": "On",
        "*": "Off"
      },
      "cover": "coverValue with the current_position attribute",
      "valve": "coverValue with the current_position attribute"
    },
    "default": {
      "unit": "unit_of_measurement not empty: the value (rounding.default) then the unit, with a space unless the unit starts with ° or %; the words below are not used then",
      "words": {
        "on": "On",
        "off": "Off",
        "home": "Home",
        "not_home": "Away",
        "unavailable": "N/A",
        "unknown": "N/A"
      },
      "wordsCompare": "the state lowercased",
      "otherwise": "the value (rounding.default)"
    }
  },
  "rounding": {
    "source": "StatusPageSnippetView.formattedNumericString and the climate case (watch only; transcribed)",
    "default": "roundNumericValues and the state parses as a number: the nearest whole number, halves away from zero (2.5 is 3, -2.5 is -3); otherwise the state as written",
    "climate": "roundNumericValues: the nearest whole number, halves away from zero; off: a whole value without decimals, else one decimal",
    "halfRule": "away from zero, unlike JavaScript's Math.round",
    "trap": "a state of inf, nan or beyond the Int range traps the watch when rounding is on; the panel should show the state as written"
  },
