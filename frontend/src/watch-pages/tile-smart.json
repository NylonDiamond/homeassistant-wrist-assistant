{
  "version": 1,
  "note": "The panel's own table: edit it here. WatchPagesTablesTests in the app repository checks the parts the watch decides against the watch's code.",
  "page": {
    "keys": [
      {
        "key": "rules",
        "default": []
      },
      {
        "key": "tileColSpan",
        "default": 4
      },
      {
        "key": "tileRowSpan",
        "default": 3
      },
      {
        "key": "tileShowLabel",
        "default": true
      },
      {
        "key": "sortOrder",
        "default": "domain"
      },
      {
        "key": "liveUpdates",
        "default": false
      },
      {
        "key": "refreshOnAppear",
        "default": false
      },
      {
        "key": "pullToRefresh",
        "default": true
      }
    ],
    "writeAll": "Every write of dynamicConfig keeps all eight keys: the phone cannot read a dynamicConfig missing one.",
    "convert": {
      "asks": "Only when the page has tiles: a dialog with title, message (one or many), cancel and convert. An empty page converts at once.",
      "writes": "dynamicConfig with the eight defaults when the page is not smart yet, items [] and groups []. Every other page key stays."
    },
    "disable": "dynamicConfig removed and nothing else, so the page is left empty. No dialog.",
    "tileSizePresets": [
      {
        "name": "Small",
        "cols": 2,
        "rows": 2
      },
      {
        "name": "Standard",
        "cols": 4,
        "rows": 3
      },
      {
        "name": "Banner",
        "cols": 4,
        "rows": 2
      },
      {
        "name": "Full Width",
        "cols": 8,
        "rows": 3
      }
    ],
    "tileSizeRule": "A preset writes tileColSpan and tileRowSpan; a box writes one. Each is clamped to spanRange. A preset shows selected while both match.",
    "spanRange": {
      "min": 1,
      "max": 12
    },
    "sortOrders": [
      {
        "value": "domain",
        "label": "By Domain"
      },
      {
        "value": "alphabetical",
        "label": "Alphabetical"
      }
    ],
    "showLabels": "tileShowLabel, the label switch of every tile a rule's style does not set.",
    "switches": [
      {
        "key": "liveUpdates",
        "label": "Live Updates",
        "detail": "Real-time via background sync",
        "shownWhen": "always"
      },
      {
        "key": "refreshOnAppear",
        "label": "Refresh on Page View",
        "detail": "Fetch states when you open this page",
        "shownWhen": "liveUpdates off"
      },
      {
        "key": "pullToRefresh",
        "label": "Pull to Refresh",
        "detail": "Swipe down to manually refresh",
        "shownWhen": "liveUpdates off"
      }
    ],
    "hiddenSwitches": "A switch hidden by Live Updates keeps its value."
  },
